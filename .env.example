DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=local-only-change-before-deploy-0123456789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Desenvolvimento usa SQLite; não depende de Docker ou PostgreSQL.
SQLITE_PATH=db.sqlite3
# Apenas em produção: config.settings.prod exige DATABASE_URL PostgreSQL.
# DATABASE_URL=postgres://usuario:senha@host:5432/helpdesk
