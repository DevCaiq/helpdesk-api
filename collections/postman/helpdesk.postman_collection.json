{
  "info": {
    "name": "Gestão de Chamados - Fluxo completo local",
    "description": "Execute na ordem com o ambiente privado gerado por seed_demo. Cada rodada abre um novo chamado; sem senhas nesta coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Saúde",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health/",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login solicitante",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/login/",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "email",
              "value": "{{solicitante_email}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{solicitante_password}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.environment.set(\"access_solicitante\", body.access);",
              "pm.environment.set(\"refresh_solicitante\", body.refresh);",
              "pm.test(\"Tokens presentes\", function () { pm.expect(body.access).to.be.a(\"string\"); pm.expect(body.refresh).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
